{
  "align_id": "ja-zh_tour_attr_0006_seg003",
  "scene": "tour",
  "domain": "attr",
  "pair": "ja-zh",
  "seg_no": "seg003",
  "src_audio": "sample/ja_tour_attr_0006_seg003_src.wav",
  "tgt_audio": "sample/zh_tour_attr_0006_seg003_tgt.wav",
  "sentences": [
    {
      "sent_id": 1,
      "src": {
        "start_ms": 220,
        "end_ms": 2180,
        "text": "第254窟。"
      },
      "tgt": {
        "start_ms": 960,
        "end_ms": 2900,
        "text": "第254号石窟。"
      },
      "notes": ""
    },
    {
      "sent_id": 2,
      "src": {
        "start_ms": 3720,
        "end_ms": 9820,
        "text": "南壁には悟りを求める釈尊が悪魔と戦う様が描かれている。"
      },
      "tgt": {
        "start_ms": 5120,
        "end_ms": 10740,
        "text": "南壁上画着求悟的释迦牟尼与恶魔战斗的情形。"
      },
      "notes": ""
    },
    {
      "sent_id": 3,
      "src": {
        "start_ms": 10760,
        "end_ms": 11680,
        "text": "「降魔」。"
      },
      "tgt": {
        "start_ms": 11700,
        "end_ms": 12620,
        "text": "“降魔”。"
      },
      "notes": ""
    },
    {
      "sent_id": 4,
      "src": {
        "start_ms": 12720,
        "end_ms": 16000,
        "text": "菩提樹の下で瞑想を続ける釈尊。"
      },
      "tgt": {
        "start_ms": 13920,
        "end_ms": 17480,
        "text": "在菩提树下坚持冥想的释迦牟尼。"
      },
      "notes": ""
    },
    {
      "sent_id": 5,
      "src": {
        "start_ms": 21720,
        "end_ms": 23660,
        "text": "その悟りを妨げようと、"
      },
      "tgt": {
        "start_ms": 22680,
        "end_ms": 24380,
        "text": "为了妨碍其开悟，"
      },
      "notes": ""
    },
    {
      "sent_id": 6,
      "src": {
        "start_ms": 23980,
        "end_ms": 26920,
        "text": "魔王が悪魔の大軍を率いて押し寄せる。"
      },
      "tgt": {
        "start_ms": 25700,
        "end_ms": 28520,
        "text": "魔王率领恶魔大军杀奔过来。"
      },
      "notes": ""
    },
    {
      "sent_id": 7,
      "src": {
        "start_ms": 38140,
        "end_ms": 40100,
        "text": "武力で威嚇する悪魔たち。"
      },
      "tgt": {
        "start_ms": 39440,
        "end_ms": 42320,
        "text": "以武力相威胁的恶魔们。"
      },
      "notes": ""
    },
    {
      "sent_id": 8,
      "src": {
        "start_ms": 47560,
        "end_ms": 49400,
        "text": "ある者は目を向き、"
      },
      "tgt": {
        "start_ms": 49260,
        "end_ms": 51040,
        "text": "有的瞪眼怒视，"
      },
      "notes": ""
    },
    {
      "sent_id": 9,
      "src": {
        "start_ms": 50260,
        "end_ms": 52480,
        "text": "ある者は大声で喚き、"
      },
      "tgt": {
        "start_ms": 51420,
        "end_ms": 52980,
        "text": "有的大声吵嚷，"
      },
      "notes": ""
    },
    {
      "sent_id": 10,
      "src": {
        "start_ms": 52700,
        "end_ms": 53480,
        "text": "攻め立てる。"
      },
      "tgt": {
        "start_ms": 53160,
        "end_ms": 54040,
        "text": "猛攻猛打。"
      },
      "notes": ""
    },
    {
      "sent_id": 11,
      "src": {
        "start_ms": 62600,
        "end_ms": 63480,
        "text": "一方、"
      },
      "tgt": {
        "start_ms": 64060,
        "end_ms": 65020,
        "text": "另一方面，"
      },
      "notes": ""
    },
    {
      "sent_id": 12,
      "src": {
        "start_ms": 63700,
        "end_ms": 67900,
        "text": "魔王の娘たちは妖艶な美女に姿を変え、"
      },
      "tgt": {
        "start_ms": 65020,
        "end_ms": 68580,
        "text": "魔王的女儿们化身成妖艳的美女，"
      },
      "notes": ""
    },
    {
      "sent_id": 13,
      "src": {
        "start_ms": 68220,
        "end_ms": 69940,
        "text": "釈尊を誘惑する。"
      },
      "tgt": {
        "start_ms": 69180,
        "end_ms": 71320,
        "text": "前来诱惑释迦牟尼。"
      },
      "notes": ""
    },
    {
      "sent_id": 14,
      "src": {
        "start_ms": 78060,
        "end_ms": 81540,
        "text": "釈尊は右手で大地を指し、"
      },
      "tgt": {
        "start_ms": 80460,
        "end_ms": 82940,
        "text": "释迦牟尼右手伸向大地，"
      },
      "notes": ""
    },
    {
      "sent_id": 15,
      "src": {
        "start_ms": 82060,
        "end_ms": 83740,
        "text": "降魔印を結ぶ。"
      },
      "tgt": {
        "start_ms": 83360,
        "end_ms": 84740,
        "text": "结降魔印。"
      },
      "notes": ""
    },
    {
      "sent_id": 16,
      "src": {
        "start_ms": 86100,
        "end_ms": 92300,
        "text": "たちまち魔王の娘たちは醜い老婆の姿に変わり果てた。"
      },
      "tgt": {
        "start_ms": 87040,
        "end_ms": 92280,
        "text": "瞬间，魔王的女儿们变成了丑陋的老太婆。"
      },
      "notes": ""
    },
    {
      "sent_id": 17,
      "src": {
        "start_ms": 104140,
        "end_ms": 107880,
        "text": "悪魔の軍勢は釈尊前にひれ伏し、"
      },
      "tgt": {
        "start_ms": 105160,
        "end_ms": 108380,
        "text": "恶魔大军败倒在释迦牟尼跟前，"
      },
      "notes": ""
    },
    {
      "sent_id": 18,
      "src": {
        "start_ms": 108120,
        "end_ms": 109020,
        "text": "退散した。"
      },
      "tgt": {
        "start_ms": 109220,
        "end_ms": 110360,
        "text": "尽皆退散。"
      },
      "notes": ""
    },
    {
      "sent_id": 19,
      "src": {
        "start_ms": 118020,
        "end_ms": 121100,
        "text": "釈尊が打ち破った悪魔の軍勢。"
      },
      "tgt": {
        "start_ms": 119520,
        "end_ms": 122120,
        "text": "释迦牟尼击破的恶魔大军，"
      },
      "notes": ""
    },
    {
      "sent_id": 20,
      "src": {
        "start_ms": 121880,
        "end_ms": 125540,
        "text": "それはすなわち自らの煩悩であった。"
      },
      "tgt": {
        "start_ms": 123480,
        "end_ms": 125780,
        "text": "即是自己心中的烦恼。"
      },
      "notes": ""
    },
    {
      "sent_id": 21,
      "src": {
        "start_ms": 130720,
        "end_ms": 133920,
        "text": "こうして釈尊は目覚めた人、"
      },
      "tgt": {
        "start_ms": 131860,
        "end_ms": 135000,
        "text": "如此，释迦牟尼变成了觉悟之人，"
      },
      "notes": ""
    },
    {
      "sent_id": 22,
      "src": {
        "start_ms": 134380,
        "end_ms": 136220,
        "text": "仏陀となったのである。"
      },
      "tgt": {
        "start_ms": 135000,
        "end_ms": 136840,
        "text": "也就是佛陀。"
      },
      "notes": ""
    },
    {
      "sent_id": 23,
      "src": {
        "start_ms": 141300,
        "end_ms": 144900,
        "text": "柱や壁面で祈りを続ける菩薩たち。"
      },
      "tgt": {
        "start_ms": 142920,
        "end_ms": 146580,
        "text": "在柱子和墙面上持续祈祷的菩萨们。"
      },
      "notes": ""
    },
    {
      "sent_id": 24,
      "src": {
        "start_ms": 147340,
        "end_ms": 152080,
        "text": "千年の間、釈尊と悪魔の攻防を見つめてきた。"
      },
      "tgt": {
        "start_ms": 148640,
        "end_ms": 153360,
        "text": "千年以来，始终注视着释迦牟尼与恶魔的攻防战。"
      },
      "notes": ""
    },
    {
      "sent_id": 25,
      "src": {
        "start_ms": 155300,
        "end_ms": 158940,
        "text": "釈尊がこの世で悟りを開くことができたのは、"
      },
      "tgt": {
        "start_ms": 156440,
        "end_ms": 159320,
        "text": "释迦牟尼在人世间得以开悟，"
      },
      "notes": ""
    },
    {
      "sent_id": 26,
      "src": {
        "start_ms": 159520,
        "end_ms": 163440,
        "text": "前世で無数の善行を重ねたためだと説かれました。"
      },
      "tgt": {
        "start_ms": 162220,
        "end_ms": 165560,
        "text": "据说是因为在前世积德行善无数。"
      },
      "notes": ""
    },
    {
      "sent_id": 27,
      "src": {
        "start_ms": 166960,
        "end_ms": 172000,
        "text": "善行の中でも最も尊い行いとされたのが「捨身」。"
      },
      "tgt": {
        "start_ms": 168320,
        "end_ms": 174380,
        "text": "在各种善行之中被看作是最值得尊重的行为便是“舍身\"。"
      },
      "notes": ""
    },
    {
      "sent_id": 28,
      "src": {
        "start_ms": 172920,
        "end_ms": 176600,
        "text": "自らの命を捧げ、他者を救うことでした。"
      },
      "tgt": {
        "start_ms": 175240,
        "end_ms": 178620,
        "text": "也就是奉献自己的生命去拯救他人。"
      },
      "notes": ""
    },
    {
      "sent_id": 29,
      "src": {
        "start_ms": 178760,
        "end_ms": 183360,
        "text": "その教えも第254窟に描かれています。"
      },
      "tgt": {
        "start_ms": 180160,
        "end_ms": 184220,
        "text": "这一教诲也被画在了第254号石窟里。"
      },
      "notes": ""
    },
    {
      "sent_id": 30,
      "src": {
        "start_ms": 187560,
        "end_ms": 188740,
        "text": "ある日、"
      },
      "tgt": {
        "start_ms": 188580,
        "end_ms": 189520,
        "text": "有一天，"
      },
      "notes": ""
    },
    {
      "sent_id": 31,
      "src": {
        "start_ms": 188980,
        "end_ms": 191060,
        "text": "釈尊は弟子たちに語りかけた。"
      },
      "tgt": {
        "start_ms": 189520,
        "end_ms": 191620,
        "text": "释迦牟尼对弟子们说道:"
      },
      "notes": ""
    },
    {
      "sent_id": 32,
      "src": {
        "start_ms": 194780,
        "end_ms": 200560,
        "text": "お前たちは私が昔苦行した時の骨を見たくはないか。"
      },
      "tgt": {
        "start_ms": 200660,
        "end_ms": 204000,
        "text": "\"你们想不想看看我过去苦行时候的尸骨?\""
      },
      "notes": ""
    },
    {
      "sent_id": 33,
      "src": {
        "start_ms": 202420,
        "end_ms": 206520,
        "text": "釈尊が雪のように白い骨を見せると、"
      },
      "tgt": {
        "start_ms": 206040,
        "end_ms": 209600,
        "text": "释迦牟尼遂以洁白似血的骨头示之。"
      },
      "notes": ""
    },
    {
      "sent_id": 34,
      "src": {
        "start_ms": 206800,
        "end_ms": 208820,
        "text": "弟子たちは驚愕した。"
      },
      "tgt": {
        "start_ms": 210140,
        "end_ms": 211600,
        "text": "众弟子惊愕。"
      },
      "notes": ""
    },
    {
      "sent_id": 35,
      "src": {
        "start_ms": 212840,
        "end_ms": 218280,
        "text": "釈尊は前世でサッタ太子という王子であった。"
      },
      "tgt": {
        "start_ms": 216820,
        "end_ms": 221000,
        "text": "释迦牟尼前世曾是一名叫做萨埵太子的王子。"
      },
      "notes": ""
    },
    {
      "sent_id": 36,
      "src": {
        "start_ms": 221240,
        "end_ms": 223460,
        "text": "サッタ太子はある日、"
      },
      "tgt": {
        "start_ms": 223580,
        "end_ms": 225140,
        "text": "萨埵太子有一天，"
      },
      "notes": ""
    },
    {
      "sent_id": 37,
      "src": {
        "start_ms": 223800,
        "end_ms": 226960,
        "text": "二人の兄とともに山に遊びに出かける。"
      },
      "tgt": {
        "start_ms": 225140,
        "end_ms": 227340,
        "text": "与两个哥哥到山中游玩。"
      },
      "notes": ""
    },
    {
      "sent_id": 38,
      "src": {
        "start_ms": 234300,
        "end_ms": 235720,
        "text": "その帰り道、"
      },
      "tgt": {
        "start_ms": 237540,
        "end_ms": 238480,
        "text": "归途中，"
      },
      "notes": ""
    },
    {
      "sent_id": 39,
      "src": {
        "start_ms": 235720,
        "end_ms": 237700,
        "text": "三人は虎の親子に出会う。"
      },
      "tgt": {
        "start_ms": 238480,
        "end_ms": 241260,
        "text": "三人遇到了一只老虎和他的孩子。"
      },
      "notes": ""
    },
    {
      "sent_id": 40,
      "src": {
        "start_ms": 241940,
        "end_ms": 247640,
        "text": "痩せさらばえたメスの虎と生まれて間もない7匹の子供たち。"
      },
      "tgt": {
        "start_ms": 245180,
        "end_ms": 250320,
        "text": "骨瘦如柴的母老虎和刚生下来不久的七只小老虎。"
      },
      "notes": ""
    },
    {
      "sent_id": 41,
      "src": {
        "start_ms": 254800,
        "end_ms": 258320,
        "text": "飢えと疲れで今にも生き絶えんばかり。"
      },
      "tgt": {
        "start_ms": 257900,
        "end_ms": 262080,
        "text": "因为饥饿和疲劳他们几乎奄奄一息。"
      },
      "notes": ""
    },
    {
      "sent_id": 42,
      "src": {
        "start_ms": 264300,
        "end_ms": 267540,
        "text": "サッタ太子は二人の兄と別れ、"
      },
      "tgt": {
        "start_ms": 266780,
        "end_ms": 269600,
        "text": "萨埵太子与两个哥哥分别后，"
      },
      "notes": ""
    },
    {
      "sent_id": 43,
      "src": {
        "start_ms": 267860,
        "end_ms": 270060,
        "text": "虎の元に戻った。"
      },
      "tgt": {
        "start_ms": 271240,
        "end_ms": 272940,
        "text": "回到老虎的身边。"
      },
      "notes": ""
    },
    {
      "sent_id": 44,
      "src": {
        "start_ms": 273300,
        "end_ms": 275860,
        "text": "そして服を脱ぎ、"
      },
      "tgt": {
        "start_ms": 276520,
        "end_ms": 277960,
        "text": "他脱下衣服，"
      },
      "notes": ""
    },
    {
      "sent_id": 45,
      "src": {
        "start_ms": 276200,
        "end_ms": 278760,
        "text": "自ら虎の前に身を横たえた。"
      },
      "tgt": {
        "start_ms": 278520,
        "end_ms": 280540,
        "text": "自己躺在老虎的面前。"
      },
      "notes": ""
    },
    {
      "sent_id": 46,
      "src": {
        "start_ms": 286580,
        "end_ms": 291440,
        "text": "しかし、衰弱した虎は大使を噛む力もない。"
      },
      "tgt": {
        "start_ms": 288040,
        "end_ms": 293180,
        "text": "但是衰弱至极的老虎连咬太子的力气都没有。"
      },
      "notes": ""
    },
    {
      "sent_id": 47,
      "src": {
        "start_ms": 295320,
        "end_ms": 298220,
        "text": "太子は崖の上に登り、"
      },
      "tgt": {
        "start_ms": 296980,
        "end_ms": 298840,
        "text": "太子爬上山崖，"
      },
      "notes": ""
    },
    {
      "sent_id": 48,
      "src": {
        "start_ms": 298540,
        "end_ms": 301860,
        "text": "枯れた竹で自らの首を切り裂いた。"
      },
      "tgt": {
        "start_ms": 299780,
        "end_ms": 302980,
        "text": "用干枯的竹子割开了自己的喉咙。"
      },
      "notes": ""
    },
    {
      "sent_id": 49,
      "src": {
        "start_ms": 305880,
        "end_ms": 308520,
        "text": "そして崖から飛び降り、"
      },
      "tgt": {
        "start_ms": 307960,
        "end_ms": 310040,
        "text": "然后从山崖上跳下，"
      },
      "notes": ""
    },
    {
      "sent_id": 50,
      "src": {
        "start_ms": 308740,
        "end_ms": 310620,
        "text": "虎に身を捧げた。"
      },
      "tgt": {
        "start_ms": 310040,
        "end_ms": 312260,
        "text": "把自己奉献给了老虎。"
      },
      "notes": ""
    },
    {
      "sent_id": 51,
      "src": {
        "start_ms": 316840,
        "end_ms": 320220,
        "text": "虎は太子の温かい血をすすり、"
      },
      "tgt": {
        "start_ms": 319700,
        "end_ms": 322680,
        "text": "老虎吸吮着太子温暖的血液，"
      },
      "notes": ""
    },
    {
      "sent_id": 52,
      "src": {
        "start_ms": 320500,
        "end_ms": 322400,
        "text": "その肉を頬張る。"
      },
      "tgt": {
        "start_ms": 323180,
        "end_ms": 324760,
        "text": "大口吃他的肉。"
      },
      "notes": ""
    },
    {
      "sent_id": 53,
      "src": {
        "start_ms": 323900,
        "end_ms": 327960,
        "text": "こうして、虎の親子は飢えを免れた。"
      },
      "tgt": {
        "start_ms": 325940,
        "end_ms": 329040,
        "text": "如此，老虎母子摆脱了饥饿。"
      },
      "notes": ""
    },
    {
      "sent_id": 54,
      "src": {
        "start_ms": 332500,
        "end_ms": 333840,
        "text": "その時、"
      },
      "tgt": {
        "start_ms": 332940,
        "end_ms": 333760,
        "text": "那时，"
      },
      "notes": ""
    },
    {
      "sent_id": 55,
      "src": {
        "start_ms": 334220,
        "end_ms": 336520,
        "text": "歓喜の歌声があたりに満ち、"
      },
      "tgt": {
        "start_ms": 333760,
        "end_ms": 336080,
        "text": "欢乐的歌声充满了四周，"
      },
      "notes": ""
    },
    {
      "sent_id": 56,
      "src": {
        "start_ms": 337100,
        "end_ms": 339900,
        "text": "飛天たちが一斉に空に現れた。"
      },
      "tgt": {
        "start_ms": 337540,
        "end_ms": 339900,
        "text": "飞天们一并出现在空中。"
      },
      "notes": ""
    },
    {
      "sent_id": 57,
      "src": {
        "start_ms": 344520,
        "end_ms": 348580,
        "text": "そしてかぐわしい花びらが降り注ぎ、"
      },
      "tgt": {
        "start_ms": 346000,
        "end_ms": 349800,
        "text": "随后芳香馥郁的花瓣倾注而下，"
      },
      "notes": ""
    },
    {
      "sent_id": 58,
      "src": {
        "start_ms": 348760,
        "end_ms": 350260,
        "text": "谷を埋めたという。"
      },
      "tgt": {
        "start_ms": 350440,
        "end_ms": 352460,
        "text": "据说填满了整个山谷。"
      },
      "notes": ""
    },
    {
      "sent_id": 59,
      "src": {
        "start_ms": 355700,
        "end_ms": 357520,
        "text": "釈尊は語り終えると、"
      },
      "tgt": {
        "start_ms": 356980,
        "end_ms": 358380,
        "text": "释迦摩尼说罢，"
      },
      "notes": ""
    },
    {
      "sent_id": 60,
      "src": {
        "start_ms": 358040,
        "end_ms": 360020,
        "text": "弟子たちにこう言った。"
      },
      "tgt": {
        "start_ms": 359000,
        "end_ms": 361120,
        "text": "又对弟子们这样说道。"
      },
      "notes": ""
    },
    {
      "sent_id": 61,
      "src": {
        "start_ms": 364220,
        "end_ms": 367220,
        "text": "これはサッタ太子の骨だ。"
      },
      "tgt": {
        "start_ms": 365120,
        "end_ms": 367320,
        "text": "这是萨埵太子的骨头。"
      },
      "notes": ""
    },
    {
      "sent_id": 62,
      "src": {
        "start_ms": 368000,
        "end_ms": 371480,
        "text": "あの時のサッタはこの私なのだ。"
      },
      "tgt": {
        "start_ms": 368420,
        "end_ms": 370260,
        "text": "那时候的萨埵就是我。"
      },
      "notes": ""
    },
    {
      "sent_id": 63,
      "src": {
        "start_ms": 376160,
        "end_ms": 379960,
        "text": "この物語は人々の心を捉え、"
      },
      "tgt": {
        "start_ms": 377360,
        "end_ms": 379840,
        "text": "这个故事深深吸引着人们，"
      },
      "notes": ""
    },
    {
      "sent_id": 64,
      "src": {
        "start_ms": 380360,
        "end_ms": 383360,
        "text": "以来、繰り返し描かれてきた。"
      },
      "tgt": {
        "start_ms": 381720,
        "end_ms": 384740,
        "text": "此后便不断反复被人描画。"
      },
      "notes": ""
    },
    {
      "sent_id": 65,
      "src": {
        "start_ms": 388260,
        "end_ms": 392740,
        "text": "サッタ太子の姿は遠く日本にも残されている。"
      },
      "tgt": {
        "start_ms": 388060,
        "end_ms": 393140,
        "text": "萨埵太子的形象在遥远的日本也得以被保留。"
      },
      "notes": ""
    },
    {
      "sent_id": 66,
      "src": {
        "start_ms": 397540,
        "end_ms": 401120,
        "text": "法隆寺の国宝ー「玉虫厨子」。"
      },
      "tgt": {
        "start_ms": 398760,
        "end_ms": 401560,
        "text": "法龙寺的国宝——“玉虫厨子”。"
      },
      "notes": ""
    },
    {
      "sent_id": 67,
      "src": {
        "start_ms": 404580,
        "end_ms": 408000,
        "text": "この厨子の側面に浮かび上がる絵物語。"
      },
      "tgt": {
        "start_ms": 405580,
        "end_ms": 409080,
        "text": "这个厨子的侧面所浮现的绘画故事。"
      },
      "notes": ""
    },
    {
      "sent_id": 68,
      "src": {
        "start_ms": 412820,
        "end_ms": 416220,
        "text": "そこには自らの身を投げ、"
      },
      "tgt": {
        "start_ms": 413680,
        "end_ms": 415940,
        "text": "那里也有舍弃自身，"
      },
      "notes": ""
    },
    {
      "sent_id": 69,
      "src": {
        "start_ms": 416440,
        "end_ms": 421040,
        "text": "虎の命を繋いだサッタ太子の姿がある。"
      },
      "tgt": {
        "start_ms": 416720,
        "end_ms": 421220,
        "text": "使老虎的生命得以延续的萨埵太子的形象。"
      },
      "notes": ""
    },
    {
      "sent_id": 70,
      "src": {
        "start_ms": 430380,
        "end_ms": 435300,
        "text": "一命をとしてまで慈悲の大切さを説く仏の姿。"
      },
      "tgt": {
        "start_ms": 432080,
        "end_ms": 437860,
        "text": "不惜以生命为代价讲述慈悲的重要性的佛的形象。"
      },
      "notes": ""
    },
    {
      "sent_id": 71,
      "src": {
        "start_ms": 438420,
        "end_ms": 440220,
        "text": "敦煌莫高窟。"
      },
      "tgt": {
        "start_ms": 439360,
        "end_ms": 440760,
        "text": "敦煌莫高窟。"
      },
      "notes": ""
    },
    {
      "sent_id": 72,
      "src": {
        "start_ms": 440500,
        "end_ms": 447620,
        "text": "第254窟の壁画は千年の時を超えて、"
      },
      "tgt": {
        "start_ms": 441180,
        "end_ms": 449540,
        "text": "第254号石窟的壁画，跨越千年的岁月，"
      },
      "notes": ""
    },
    {
      "sent_id": 73,
      "src": {
        "start_ms": 448380,
        "end_ms": 451200,
        "text": "人々の心を揺さぶり続ける。"
      },
      "tgt": {
        "start_ms": 450480,
        "end_ms": 452740,
        "text": "始终震撼着人们的心灵。"
      },
      "notes": ""
    },
    {
      "sent_id": 74,
      "src": {
        "start_ms": 466020,
        "end_ms": 469840,
        "text": "僧侶の修行の場として始まった莫高窟。"
      },
      "tgt": {
        "start_ms": 466840,
        "end_ms": 470080,
        "text": "起初作为僧侣修行之地的莫高窟。"
      },
      "notes": ""
    },
    {
      "sent_id": 75,
      "src": {
        "start_ms": 470860,
        "end_ms": 476040,
        "text": "そこは功徳を積もうとする在家信者の祈りの場でもありました。"
      },
      "tgt": {
        "start_ms": 471460,
        "end_ms": 477260,
        "text": "这里也曾是想要积攒功德的在家信者的祈祷场所。"
      },
      "notes": ""
    },
    {
      "sent_id": 76,
      "src": {
        "start_ms": 482640,
        "end_ms": 489060,
        "text": "石窟にはその造営のために尽力した寄進者の姿が描かれています。"
      },
      "tgt": {
        "start_ms": 483020,
        "end_ms": 490980,
        "text": "在石窟里有那些为建造石窟而尽力的捐赠者的形象，他们也被画了下来。"
      },
      "notes": ""
    },
    {
      "sent_id": 77,
      "src": {
        "start_ms": 494040,
        "end_ms": 496200,
        "text": "男性の姿に混じって、"
      },
      "tgt": {
        "start_ms": 495520,
        "end_ms": 497460,
        "text": "除了众多男性人物以外，"
      },
      "notes": ""
    },
    {
      "sent_id": 78,
      "src": {
        "start_ms": 496460,
        "end_ms": 498740,
        "text": "女性たちの姿もありました。"
      },
      "tgt": {
        "start_ms": 497460,
        "end_ms": 498940,
        "text": "也有一些女性。"
      },
      "notes": ""
    },
    {
      "sent_id": 79,
      "src": {
        "start_ms": 510440,
        "end_ms": 514680,
        "text": "当時の女性たちの心を強く引きつけた物語が"
      },
      "tgt": {
        "start_ms": 512120,
        "end_ms": 514760,
        "text": "深深吸引当时女性的故事，"
      },
      "notes": ""
    },
    {
      "sent_id": 80,
      "src": {
        "start_ms": 514680,
        "end_ms": 518040,
        "text": "第296窟に登場します。"
      },
      "tgt": {
        "start_ms": 517160,
        "end_ms": 520340,
        "text": "出现在了第296号石窟。"
      },
      "notes": ""
    },
    {
      "sent_id": 81,
      "src": {
        "start_ms": 526040,
        "end_ms": 530320,
        "text": "6世紀に開かれた第296窟。"
      },
      "tgt": {
        "start_ms": 528000,
        "end_ms": 531980,
        "text": "6世纪开凿的第296号石窟。"
      },
      "notes": ""
    },
    {
      "sent_id": 82,
      "src": {
        "start_ms": 533040,
        "end_ms": 534920,
        "text": "微妙比丘尼因縁図。"
      },
      "tgt": {
        "start_ms": 533500,
        "end_ms": 535880,
        "text": "微妙比丘尼因缘图。"
      },
      "notes": ""
    },
    {
      "sent_id": 83,
      "src": {
        "start_ms": 535720,
        "end_ms": 541220,
        "text": "古代インドの女性微妙が仏門に入るまでの説話図で、"
      },
      "tgt": {
        "start_ms": 538540,
        "end_ms": 544680,
        "text": "描绘了古代印度一名叫微妙的女性遁入佛门之前的神话故事。"
      },
      "notes": ""
    },
    {
      "sent_id": 84,
      "src": {
        "start_ms": 543960,
        "end_ms": 547740,
        "text": "物語は微妙の前世から始まる。"
      },
      "tgt": {
        "start_ms": 546340,
        "end_ms": 548920,
        "text": "故事从微妙的前世开始。"
      },
      "notes": ""
    },
    {
      "sent_id": 85,
      "src": {
        "start_ms": 548440,
        "end_ms": 550880,
        "text": "裕福な家に嫁いだ微妙。"
      },
      "tgt": {
        "start_ms": 551020,
        "end_ms": 553160,
        "text": "嫁入富裕人家的微妙。"
      },
      "notes": ""
    },
    {
      "sent_id": 86,
      "src": {
        "start_ms": 554540,
        "end_ms": 559220,
        "text": "第2夫人が生んだ男の子を嫉妬のために殺してしまう。"
      },
      "tgt": {
        "start_ms": 557740,
        "end_ms": 561680,
        "text": "因嫉妒二夫人生的是男孩，便将孩子杀害了。"
      },
      "notes": ""
    },
    {
      "sent_id": 87,
      "src": {
        "start_ms": 561840,
        "end_ms": 565840,
        "text": "罪を問い詰められた微妙は手をあげて誓う。"
      },
      "tgt": {
        "start_ms": 562400,
        "end_ms": 566240,
        "text": "被追问罪责的微妙举手发誓。"
      },
      "notes": ""
    },
    {
      "sent_id": 88,
      "src": {
        "start_ms": 570220,
        "end_ms": 573060,
        "text": "もし、私が殺したのなら"
      },
      "tgt": {
        "start_ms": 572720,
        "end_ms": 574140,
        "text": "如果是我杀的，"
      },
      "notes": ""
    },
    {
      "sent_id": 89,
      "src": {
        "start_ms": 573780,
        "end_ms": 575440,
        "text": "生まれ変わった来世で、"
      },
      "tgt": {
        "start_ms": 574880,
        "end_ms": 576080,
        "text": "在我的来世，"
      },
      "notes": ""
    },
    {
      "sent_id": 90,
      "src": {
        "start_ms": 575720,
        "end_ms": 577740,
        "text": "夫は蛇に噛み殺され、"
      },
      "tgt": {
        "start_ms": 576420,
        "end_ms": 578480,
        "text": "我的丈夫会被蛇咬死，"
      },
      "notes": ""
    },
    {
      "sent_id": 91,
      "src": {
        "start_ms": 577740,
        "end_ms": 579800,
        "text": "子供は水に流され、"
      },
      "tgt": {
        "start_ms": 579300,
        "end_ms": 581040,
        "text": "孩子会被水冲走、"
      },
      "notes": ""
    },
    {
      "sent_id": 92,
      "src": {
        "start_ms": 580040,
        "end_ms": 582100,
        "text": "狼に食われるでしょう。"
      },
      "tgt": {
        "start_ms": 581540,
        "end_ms": 582860,
        "text": "被狼吃掉。"
      },
      "notes": ""
    },
    {
      "sent_id": 93,
      "src": {
        "start_ms": 586920,
        "end_ms": 588540,
        "text": "この世に生まれ変わり、"
      },
      "tgt": {
        "start_ms": 588420,
        "end_ms": 590000,
        "text": "转世回到人间，"
      },
      "notes": ""
    },
    {
      "sent_id": 94,
      "src": {
        "start_ms": 589220,
        "end_ms": 591820,
        "text": "一見幸せそうに見える微妙。"
      },
      "tgt": {
        "start_ms": 591120,
        "end_ms": 593420,
        "text": "这时看似幸福的微妙。"
      },
      "notes": ""
    },
    {
      "sent_id": 95,
      "src": {
        "start_ms": 593580,
        "end_ms": 597160,
        "text": "しかし、次々と不幸に見舞われる。"
      },
      "tgt": {
        "start_ms": 596080,
        "end_ms": 598180,
        "text": "然而不幸接踵而至。"
      },
      "notes": ""
    },
    {
      "sent_id": 96,
      "src": {
        "start_ms": 608180,
        "end_ms": 611200,
        "text": "旅の途中、寝ている間に、"
      },
      "tgt": {
        "start_ms": 609720,
        "end_ms": 611880,
        "text": "旅途中在睡觉时，"
      },
      "notes": ""
    },
    {
      "sent_id": 97,
      "src": {
        "start_ms": 611200,
        "end_ms": 613660,
        "text": "夫が蛇に噛み殺されてしまう。"
      },
      "tgt": {
        "start_ms": 612600,
        "end_ms": 614340,
        "text": "丈夫被蛇咬死了。"
      },
      "notes": ""
    },
    {
      "sent_id": 98,
      "src": {
        "start_ms": 620080,
        "end_ms": 623440,
        "text": "さらに、川を渡ろうとした時、"
      },
      "tgt": {
        "start_ms": 621720,
        "end_ms": 623460,
        "text": "后来在过河时，"
      },
      "notes": ""
    },
    {
      "sent_id": 99,
      "src": {
        "start_ms": 624640,
        "end_ms": 628720,
        "text": "二人の子供の一人は川に流され、"
      },
      "tgt": {
        "start_ms": 625380,
        "end_ms": 628840,
        "text": "两个孩子中的一个被河水冲走，"
      },
      "notes": ""
    },
    {
      "sent_id": 100,
      "src": {
        "start_ms": 633620,
        "end_ms": 636700,
        "text": "もう一人は狼に食われてしまう。"
      },
      "tgt": {
        "start_ms": 635440,
        "end_ms": 637460,
        "text": "另一个被狼吃掉了。"
      },
      "notes": ""
    },
    {
      "sent_id": 101,
      "src": {
        "start_ms": 642780,
        "end_ms": 646900,
        "text": "この後も、あらゆる困難を経験する微妙。"
      },
      "tgt": {
        "start_ms": 643300,
        "end_ms": 647840,
        "text": "之后经历了各种苦难的微妙。"
      },
      "notes": ""
    },
    {
      "sent_id": 102,
      "src": {
        "start_ms": 660300,
        "end_ms": 663700,
        "text": "やがて、自らの行いを悔い、"
      },
      "tgt": {
        "start_ms": 661920,
        "end_ms": 665100,
        "text": "最终为自己的行为而感到后悔，"
      },
      "notes": ""
    },
    {
      "sent_id": 103,
      "src": {
        "start_ms": 664220,
        "end_ms": 665420,
        "text": "比丘尼となって、"
      },
      "tgt": {
        "start_ms": 665300,
        "end_ms": 667340,
        "text": "成为了一名比丘尼，"
      },
      "notes": ""
    },
    {
      "sent_id": 104,
      "src": {
        "start_ms": 666060,
        "end_ms": 670300,
        "text": "仏門に帰依するところで物語は終わっている。"
      },
      "tgt": {
        "start_ms": 669800,
        "end_ms": 673000,
        "text": "故事到其皈依佛门之后便结束了。"
      },
      "notes": ""
    },
    {
      "sent_id": 105,
      "src": {
        "start_ms": 678200,
        "end_ms": 681940,
        "text": "古代インドに起源を持つこの物語は、"
      },
      "tgt": {
        "start_ms": 681000,
        "end_ms": 683560,
        "text": "起源于古代印度的这个故事，"
      },
      "notes": ""
    },
    {
      "sent_id": 106,
      "src": {
        "start_ms": 682360,
        "end_ms": 684220,
        "text": "日本にも伝えられた。"
      },
      "tgt": {
        "start_ms": 683760,
        "end_ms": 685360,
        "text": "也流传到了日本。"
      },
      "notes": ""
    },
    {
      "sent_id": 107,
      "src": {
        "start_ms": 686680,
        "end_ms": 688580,
        "text": "今昔物語集。"
      },
      "tgt": {
        "start_ms": 687540,
        "end_ms": 688960,
        "text": "今昔物语集。"
      },
      "notes": ""
    },
    {
      "sent_id": 108,
      "src": {
        "start_ms": 689040,
        "end_ms": 692500,
        "text": "インドの物語を集めた天竺の部に"
      },
      "tgt": {
        "start_ms": 690140,
        "end_ms": 693320,
        "text": "在收录了印度故事的天竺部里，"
      },
      "notes": ""
    },
    {
      "sent_id": 109,
      "src": {
        "start_ms": 692860,
        "end_ms": 695420,
        "text": "微妙の物語が収められている。"
      },
      "tgt": {
        "start_ms": 694220,
        "end_ms": 696040,
        "text": "便记录有微妙的故事。"
      },
      "notes": ""
    },
    {
      "sent_id": 110,
      "src": {
        "start_ms": 699960,
        "end_ms": 701520,
        "text": "インドから敦煌、"
      },
      "tgt": {
        "start_ms": 701040,
        "end_ms": 702820,
        "text": "从印度到敦煌，"
      },
      "notes": ""
    },
    {
      "sent_id": 111,
      "src": {
        "start_ms": 701920,
        "end_ms": 706800,
        "text": "そして日本にも伝えられた一人の女性の物語。"
      },
      "tgt": {
        "start_ms": 702820,
        "end_ms": 707100,
        "text": "然后还流传到日本的关于一名女性的故事。"
      },
      "notes": ""
    },
    {
      "sent_id": 112,
      "src": {
        "start_ms": 710460,
        "end_ms": 715220,
        "text": "未明の物語は、場所を移し、時代を超えて、"
      },
      "tgt": {
        "start_ms": 711300,
        "end_ms": 715960,
        "text": "微妙的故事跨越地域、超越时空，"
      },
      "notes": ""
    },
